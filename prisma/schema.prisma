// ========================
// Prisma schema (updated for Tahap 2)
// ========================

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// ENUMS (tetap dipertahankan untuk kompatibilitas kode lama)
// ===============================================================================

enum Role {
  ADMIN
  PIC
  VERIFIKATOR
}

enum ComplaintStatus {
  BELUM_DITANGANI
  DALAM_PENANGANAN
  MENUNGGU_VERIFIKASI
  TERVERIFIKASI
}

enum VerificationResult {
  APPROVED
  REJECTED
}

enum ComplaintCategory {
  KESELAMATAN_KEAMANAN // P0: Keamanan, barang tertinggal, pelecehan
  FASILITAS_KERETA // P1: AC, toilet, stopkontak, kebersihan kereta
  FASILITAS_STASIUN // P2: Eskalator, peron, ruang tunggu stasiun
  TIKET_DAN_SISTEM // P2: Access by KAI, e-boarding pass, loket
  PELAYANAN_PETUGAS // P3: Sikap/keramahan kondektur, prama/prami, petugas
  REFUND_DAN_TARIF // P3: Restitusi pembatalan tiket, selisih bea
  INFORMASI_DAN_LAINNYA // P4: Pertanyaan jadwal, keluhan umum
}

enum ReopenStatus {
  PENDING // Menunggu persetujuan Admin
  APPROVED // Disetujui Admin -> kembali ke DALAM_PENANGANAN
  REJECTED // Ditolak Admin -> tetap TERVERIFIKASI
}

enum DocumentStatus {
  DRAFT // Konsep / Draf dokumen
  PUBLISHED // Resmi diterbitkan & dikunci sebagai arsip
  ARCHIVED // Arsip non-aktif
  SUPERSEDED // Telah digantikan oleh dokumen revisi baru
}

enum AuditAction {
  CREATE_COMPLAINT // Registrasi keluhan baru
  UPDATE_COMPLAINT // Edit data pokok keluhan
  ASSIGN_PIC // Penugasan / pergantian PIC
  SAVE_PROGRESS // Simpan draf penanganan PIC
  SUBMIT_VERIFICATION // Pengajuan hasil penanganan ke verifikator
  VERIFY_APPROVED // Verifikator menyetujui hasil penanganan
  VERIFY_REJECTED // Verifikator menolak hasil penanganan
  REQUEST_REOPEN // Pengajuan permohonan pembukaan kembali
  APPROVE_REOPEN // Admin menyetujui permohonan pembukaan kembali
  REJECT_REOPEN // Admin menolak permohonan pembukaan kembali
  GENERATE_DOCUMENT // Penerbitan dokumen rekapitulasi baru
  REVISE_DOCUMENT // Penerbitan dokumen versi revisi
  DELETE_COMPLAINT // Penghapusan keluhan
}

// ==============================================================================
// MODELS
// ===============================================================================

model User {
  id                String              @id @default(uuid())
  nipp              String              @unique
  name              String
  password          String
  role              Role                @default(PIC)
  isActive          Boolean             @default(true)
  mustChangePassword Boolean            @default(false)
  failedAttempts    Int                 @default(0)
  lockedUntil       DateTime?
  assignedTasks     Complaint[]         @relation("PicComplaints")
  verifications     Verification[]      @relation("VerifierRecords")
  documents         Document[]          @relation("DocCreator")
  reopenRequests    ReopenRequest[]     @relation("ReopenRequester")
  reviewedReopens   ReopenRequest[]     @relation("ReopenReviewer")
  auditLogs         AuditLog[]          @relation("UserAuditLogs")
  createdAt         DateTime            @default(now())
  ComplaintAuditLog ComplaintAuditLog[]

  @@index([role])
}

model Complaint {
  id              String             @id @default(uuid())
  complaintNumber String             @unique // Contoh: CMP-2026-001
  date            DateTime // Tanggal kejadian / pelaporan keluhan oleh penumpang
  customerName    String // Nama personil / pengguna layanan
  customerContact String? // Nomor kontak / WhatsApp pelapor
  daopOrStation   String? // Stasiun / Wilayah Daop operasional KAI
  source          String // Telepon, survey, email, Access by KAI, dll.
  category        ComplaintCategory? // Klasifikasi jenis keluhan
  description     String             @db.Text
  status          ComplaintStatus    @default(BELUM_DITANGANI)

  // Penugasan PIC & Audit Waktu Operasional
  picId           String?
  pic             User?     @relation("PicComplaints", fields: [picId], references: [id], onDelete: SetNull)
  assignedAt      DateTime? // Waktu PIC ditugaskan
  submittedAt     DateTime? // Waktu pengajuan verifikasi oleh PIC
  completedAt     DateTime? // Waktu resmi disetujui verifikator
  submissionCount Int       @default(0) // Jumlah siklus PIC submit penanganan

  // Tindakan Penanganan Lapangan
  correctiveAction String? @db.Text // Tindakan perbaikan
  preventiveAction String? @db.Text // Tindakan pencegahan
  proofImageUrl    String? @db.Text // URL foto bukti perbaikan di lapangan (Cloudinary)
  notes            String? @db.Text // Keterangan

  // Relasi & Jejak Audit
  verifications  Verification[]  @relation("ComplaintVerifications")
  reopenRequests ReopenRequest[] @relation("ComplaintReopens")
  auditLogs      AuditLog[]      @relation("ComplaintAuditLogs")
  documentId     String?
  document       Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------------------------------------------
  // 2A – Penambahan kolom master & SLA (sementara nullable)
  // -------------------------------------------------------------
  areaId     String? @map("areaId") @db.VarChar(191) // FK ke OperationalArea (nullable untuk migrasi)
  sourceId   String? @map("sourceId") @db.VarChar(191) // FK ke ComplaintSource (nullable untuk migrasi)
  categoryId String  @map("categoryId") @db.VarChar(191) // FK ke ComplaintCategoryMaster (non‑null after backfill)

  slaHours           Int?      @map("slaHours") // snapshot SLA saat keluhan dibuat
  slaStartAt         DateTime? @map("slaStartAt") // saat SLA mulai dihitung
  slaDeadlineInitial DateTime? @map("slaDeadlineInitial") // deadline awal (tidak pernah berubah)
  slaDeadline        DateTime? @map("slaDeadline") // deadline efektif (berubah bila ditolak)

  // Relations to master tables
  operationalArea   OperationalArea?        @relation("ComplaintOperationalArea", fields: [areaId], references: [id], map: "fk_complaint_operational_area")
  complaintSource   ComplaintSource?        @relation("ComplaintSource", fields: [sourceId], references: [id])
  complaintCategory ComplaintCategoryMaster @relation("ComplaintCategoryMaster", fields: [categoryId], references: [id])
  slaExtensions     SlaExtension[]
  ComplaintAuditLog ComplaintAuditLog[]

  @@index([status])
  @@index([createdAt])
  @@index([category])
  @@index([status, picId])
  @@index([categoryId])
  @@index([areaId])
  @@index([sourceId])
  @@index([slaDeadline])
}

model Verification {
  id           String             @id @default(uuid())
  complaintId  String
  complaint    Complaint          @relation("ComplaintVerifications", fields: [complaintId], references: [id], onDelete: Cascade)
  verifierId   String
  verifier     User               @relation("VerifierRecords", fields: [verifierId], references: [id], onDelete: Restrict)
  result       VerificationResult
  feedback     String?            @db.Text // Kesimpulan verifikasi atau alasan penolakan
  cycle        Int                @default(1) // Nomor putaran siklus pengajuan & verifikasi
  verifiedAt   DateTime           @default(now())
  SlaExtension SlaExtension?

  @@index([complaintId, verifiedAt])
}

model ReopenRequest {
  id            String       @id @default(uuid())
  complaintId   String
  complaint     Complaint    @relation("ComplaintReopens", fields: [complaintId], references: [id], onDelete: Restrict)
  requestedById String
  requester     User         @relation("ReopenRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reason        String       @db.Text // Alasan pembukaan kembali keluhan
  status        ReopenStatus @default(PENDING)
  reviewedById  String?
  reviewer      User?        @relation("ReopenReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  adminNotes    String?      @db.Text // Alasan / catatan keputusan persetujuan atau penolakan oleh Admin
  requestedAt   DateTime     @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([complaintId])
  @@index([status])
  @@index([requestedAt])
}

model Document {
  id               String         @id @default(uuid())
  documentNumber   String // Format: FR.SM/TI/033.001/10-2020
  version          String         @default("002-2020")
  revisionNumber   Int            @default(0) // 0 = Dokumen Master Pertama, 1 = Revisi ke-1, dst
  parentDocumentId String?
  parentDocument   Document?      @relation("DocumentRevisions", fields: [parentDocumentId], references: [id], onDelete: Restrict)
  revisions        Document[]     @relation("DocumentRevisions")
  revisionReason   String?        @db.Text // Alasan penerbitan revisi jika menerbitkan dokumen lama
  status           DocumentStatus @default(PUBLISHED)
  documentDate     DateTime // Tanggal penetapan dokumen
  publishedAt      DateTime?      @default(now()) // Waktu penerbitan resmi
  createdById      String
  createdBy        User           @relation("DocCreator", fields: [createdById], references: [id], onDelete: Restrict)
  managementRep    String // Nama Management Representative KAI
  complaints       Complaint[] // Relasi aktif keluhan yang termasuk
  snapshotData     Json? // IMMUTABLE SNAPSHOT: Salinan beku seluruh keluhan saat dokumen terbit
  totalComplaints  Int            @default(0) // Total baris keluhan dalam dokumen
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  @@index([documentNumber])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id          String      @id @default(uuid())
  complaintId String?
  complaint   Complaint?  @relation("ComplaintAuditLogs", fields: [complaintId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?       @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  entity      String      @default("Complaint")
  entityId    String
  details     Json? // Metadata perubahan (sebelum vs sesudah) - DILARANG menyimpan password/token
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([complaintId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model ComplaintCounter {
  id           String   @id @default(uuid())
  year         Int      @unique // Tahun berjalan, di-reset setiap tahun
  lastSequence Int      @default(0) // Nomor urut terakhir yang digunakan
  updatedAt    DateTime @updatedAt
}

model DocumentCounter {
  id           String   @id @default(uuid())
  year         Int
  month        Int
  lastSequence Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([year, month])
}

// -------------------------------------------------------------
// 2A – Master data baru (perlu seed)
// -------------------------------------------------------------
model OperationalArea {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(191) // contoh: “Daop 1 Jakarta”
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complaints Complaint[] @relation("ComplaintOperationalArea")
}

model ComplaintSource {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(191) // contoh: “Survey”, “Telepon”, “Email”, dll.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complaints Complaint[] @relation("ComplaintSource")
}

model ComplaintCategoryMaster {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(191) // mis. “Umum / Belum Dikategorikan”
  slaHours    Int // target SLA dalam jam kerja
  description String? // opsional
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complaints Complaint[] @relation("ComplaintCategoryMaster")
}

// -------------------------------------------------------------
// 2A – SLA ekstensi (verifikator menolak)
// -------------------------------------------------------------
model SlaExtension {
  id                String       @id @default(uuid())
  complaintId       String // satu keluhan bisa punya banyak perpanjangan (setiap penolakan Verifikator)
  complaint         Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  verificationId    String       @unique
  verification      Verification @relation(fields: [verificationId], references: [id])
  extraWorkingDays  Int // tambahan waktu perbaikan dalam HARI kerja
  rejectedAt        DateTime
  newDeadline       DateTime
  createdAt         DateTime     @default(now())

  @@index([complaintId])
}

// -------------------------------------------------------------
// 2A – Audit log keluhan (detail perubahan)
// -------------------------------------------------------------
model ComplaintAuditLog {
  id          String     @id @default(uuid())
  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  action      String
  oldValue    Json?
  newValue    Json?
  actorId     String?
  actor       User?      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())

  @@index([complaintId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 2A – Hari libur (Kalender)
// -------------------------------------------------------------
model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// 2A – Arsip laporan bulanan
// -------------------------------------------------------------
enum MonthlyReportStatus {
  PENDING
  SUCCESS
  FAILED
}

model MonthlyReport {
  id            String              @id @default(uuid())
  period        String              @unique @db.VarChar(7) // format YYYY‑MM
  storageKey    String?
  sha256        String?             @db.VarChar(64)
  status        MonthlyReportStatus
  error         String?             @db.Text
  generatedAt   DateTime?
  generatedById String? // null = sistem, else User.id
  createdAt     DateTime            @default(now())

  @@index([status])
  @@index([generatedAt])
}
