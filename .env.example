# ==============================================================================
# Database MySQL (XAMPP Lokal)
# Format: mysql://USER:PASSWORD@HOST:PORT/DB_NAME
# Contoh XAMPP default (tanpa password): mysql://root:@localhost:3306/spkp_kai
# ==============================================================================
DATABASE_URL="mysql://root:@localhost:3306/spkp_kai"

# ==============================================================================
# NextAuth.js — Autentikasi
# NEXTAUTH_SECRET: Wajib diisi dengan string acak yang kuat (min 32 karakter)
# Generate: openssl rand -base64 32
# ==============================================================================
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="ganti-dengan-string-acak-yang-kuat-min-32-karakter"

# ==============================================================================
# Cloudinary — Penyimpanan Foto Bukti Perbaikan Lapangan
# Daftarkan akun gratis di: https://cloudinary.com/
# Temukan nilai di: Cloudinary Dashboard > Settings > API Keys
# ==============================================================================
CLOUDINARY_CLOUD_NAME="nama-cloud-anda"
CLOUDINARY_API_KEY="api-key-anda"
CLOUDINARY_API_SECRET="api-secret-anda"